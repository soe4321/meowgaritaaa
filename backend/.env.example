# Environment Configuration for CampusOD Backend

PORT=4000
NODE_ENV=development

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://campus_user:campus_password_2026@localhost:5432/campus_od_db?schema=public"

# JWT Secret & Expiration
JWT_SECRET="campus_od_super_secure_jwt_secret_token_key_2026"
JWT_EXPIRES_IN="7d"

# File Upload Directory
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
